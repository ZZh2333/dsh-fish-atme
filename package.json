{
  "name": "dsh-fish-atme",
  "version": "0.2.0",
  "description": "DSH 插件：盯着 B 站「@我的」，只回你本人 —— 定时轮询 + 人格化回复 + 三道安全闸",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "at-me",
    "auto-reply"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ZZh2333/dsh-fish-atme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZZh2333/dsh-fish-atme.git"
  },
  "bugs": {
    "url": "https://github.com/ZZh2333/dsh-fish-atme/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "tests",
    "client.js",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
